generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  decks        Deck[]
}

model Card {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  rulesText       String
  flavorText      String?
  faction         String
  type            String
  rarity          String
  cost            Int
  attack          Int?
  health          Int?
  setCode         String
  collectorNumber Int
  tags            CardTag[]
  deckCards       DeckCard[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([setCode, collectorNumber])
  @@index([name])
  @@index([faction])
  @@index([type])
  @@index([rarity])
  @@index([cost])
}

model Deck {
  id          String     @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cards       DeckCard[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId, updatedAt])
}

model DeckCard {
  deckId   String
  cardId   String
  quantity Int    @default(1)
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@id([deckId, cardId])
  @@index([cardId])
}

model CardTag {
  cardId String
  tag    String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, tag])
  @@index([tag])
}
