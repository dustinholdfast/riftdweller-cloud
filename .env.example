# For local development against `docker compose up -d` (see README), use:
# DATABASE_URL="postgresql://prisma:prisma@localhost:5435/riftdweller"
# DIRECT_URL="postgresql://prisma:prisma@localhost:5435/riftdweller"
#
# For Supabase (used in Preview/Production), use the Supavisor transaction
# pooler (port 6543) for Next.js runtime queries. Percent-encode reserved
# characters in the password before placing it in a URL.
DATABASE_URL="postgresql://prisma.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Supabase direct/session connection (port 5432) for Prisma migrations and seeds.
DIRECT_URL="postgresql://prisma.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-output-from-npx-auth-secret"
